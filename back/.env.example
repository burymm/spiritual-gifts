# Скопируйте в .env и заполните. Файл .env в .gitignore и не попадает в репозиторий.

# Supabase → кнопка Connect → вкладка Database → Session pooler → URI.
# Регион проекта — eu-west-1, порт session-пуллера — 5432.
# Вставьте строку целиком и подставьте пароль базы вместо <ПАРОЛЬ>.
# Поддерживается и любой другой Postgres (VPS): ssl-нормализация ниже сработает
# только для хостов *.supabase.co / *.supabase.in.
DATABASE_URL=postgresql://postgres.<project-ref>:<ПАРОЛЬ>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# С какого origin принимать запросы фронта (ng serve).
CORS_ORIGIN=http://localhost:4200

# Порт API.
PORT=3000

# --- Вход ---
# google — настоящий OAuth через Google; mock — эмуляция входа для локальной
# сборки (вводишь почту, токен подписывается тем же секретом).
# Если AUTH_MODE не задан: google при заполненных GOOGLE_CLIENT_ID и
# GOOGLE_CLIENT_SECRET, иначе mock.
AUTH_MODE=mock

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI должен совпадать с тем, что соберёт бэк:
#   http://127.0.0.1:3000/api/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Секрет подписи токенов входа — любая длинная случайная строка.
# Без него сервер генерирует случайный при каждом запуске:
# вход работать будет, но после рестарта все сессии слетят.
# SESSION_SECRET=

# Фронт, куда возвращаемся после входа, и публичный адрес самого API
# (из него собирается redirect_uri Google).
FRONT_ORIGIN=http://localhost:4200
API_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Срок жизни токена входа в часах (по умолчанию 30 суток).
SESSION_TTL_HOURS=720

# Должно совпадать с front/src/app/core/config.ts:
# QUALITY_COUNT = 24 (число качеств), BASE_WEIGHT = 50 (пул = 1200).
QUALITY_COUNT=24
BASE_WEIGHT=50